{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#v1.3.0",
    "github>StackVista/renovate-config:go#v1.3.0",
    "github>StackVista/renovate-config:docker#v1.3.0",
    "github>StackVista/renovate-config:automerge#v1.3.0"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "renovate-config",
        "github-actions"
      ],
      "matchPackageNames": [
        "StackVista/renovate-config"
      ],
      "groupName": "Renovate configuration",
      "groupSlug": "renovate-config",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false
    }
  ]
}
